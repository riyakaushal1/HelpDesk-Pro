PORT=5000
NODE_ENV=development
MONGODB_URI=
# Optional process-local resolver override if your network DNS blocks Atlas SRV lookups.
# Example for local development only: MONGODB_DNS_SERVERS=8.8.8.8
MONGODB_DNS_SERVERS=
# Generate a unique random value with at least 32 characters; never use an example value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated exact frontend origins. Production must set this explicitly.
CORS_ORIGINS=
# SMTP settings: Brevo SMTP is recommended for development and deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Generate a random value with at least 32 characters; keep it private and stable.
EMAIL_VERIFICATION_SECRET=
